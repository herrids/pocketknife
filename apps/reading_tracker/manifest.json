{
  "app": { "id": "reading_tracker", "name": "Reading Tracker", "emoji": "📚", "color": "#8E86CF", "version": 1 },
  "entities": [
    {
      "id": "ent_book",
      "name": "book",
      "operations": ["create", "read", "update", "delete"],
      "fields": [
        { "id": "fld_title",  "name": "title",  "type": "text",    "required": true, "max": 200 },
        { "id": "fld_author", "name": "author", "type": "text" },
        { "id": "fld_rating", "name": "rating", "type": "integer", "min": 1, "max": 5 },
        { "id": "fld_done",   "name": "done",   "type": "boolean", "default": false }
      ]
    }
  ],
  "tools": [
    {
      "id": "tool_mark_book_finished",
      "name": "mark_book_finished",
      "description": "Mark a book as finished (or unfinished)",
      "params": [
        { "id": "p_book_id", "name": "book_id", "type": "reference", "target": "ent_book", "required": true },
        { "id": "p_done", "name": "done", "type": "boolean", "default": true }
      ],
      "steps": [
        { "op": "update", "entity": "ent_book", "rowId": "$params.book_id", "set": { "done": "$params.done" } }
      ]
    }
  ],
  "frontend": { "dist": "frontend/dist" }
}
